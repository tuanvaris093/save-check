{
  "name": "save-check",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:login": "wrangler login",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "db:create": "wrangler d1 create save-check-db --config worker/wrangler.toml",
    "db:migrate": "wrangler d1 execute save-check-db --local --file=./worker/src/db/schema.sql --config worker/wrangler.toml",
    "db:seed": "wrangler d1 execute save-check-db --local --file=./worker/src/db/seed.sql --config worker/wrangler.toml",
    "db:migrate:remote": "wrangler d1 execute save-check-db --remote --file=./worker/src/db/schema.sql --config worker/wrangler.toml",
    "db:seed:remote": "wrangler d1 execute save-check-db --remote --file=./worker/src/db/seed.sql --config worker/wrangler.toml",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "next": "^15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.4",
    "@hookform/resolvers": "^5.0.1",
    "zod": "^3.25.67",
    "lucide-react": "^0.525.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "tailwindcss": "^4.1.8",
    "@tailwindcss/postcss": "^4.1.8",
    "postcss": "^8.5.6",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.4",
    "@eslint/eslintrc": "^3.3.1",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12"
  }
}

{
  "name": "save-check",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "worker:dev": "bunx wrangler dev --config worker/wrangler.toml",
    "worker:login": "bunx wrangler login",
    "worker:deploy": "bunx wrangler deploy --config worker/wrangler.toml --env production",
    "worker:deploy:staging": "bunx wrangler deploy --config worker/wrangler.toml --env p9",
    "db:create": "bunx wrangler d1 create save-check-db --config worker/wrangler.toml",
    "db:migrate": "node scripts/d1-migrate.mjs --local",
    "db:seed": "bunx wrangler d1 execute save-check-db --local --file=./worker/src/db/seed.sql --config worker/wrangler.toml",
    "db:truncate": "bunx wrangler d1 execute save-check-db --local --file=./worker/src/db/truncate.sql --config worker/wrangler.toml",
    "db:migrate:remote": "node scripts/d1-migrate.mjs --remote",
    "db:seed:remote": "bunx wrangler d1 execute save-check-db --remote --file=./worker/src/db/seed.sql --config worker/wrangler.toml",
    "db:truncate:remote": "bunx wrangler d1 execute save-check-db --remote --file=./worker/src/db/truncate.sql --config worker/wrangler.toml",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src worker/src shared scripts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "db:migrate:local": "node scripts/d1-migrate.mjs --local",
    "db:migrations:list": "worker/node_modules/.bin/wrangler d1 migrations list save-check-db --local --config worker/wrangler.toml",
    "test:v3": "node scripts/test-v3.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "test:v3:d1": "node scripts/test-d1-v3.mjs",
    "test:p2": "node scripts/test-p2-api.mjs",
    "test:p3": "node scripts/test-p3.mjs",
    "test:p3:browser": "node scripts/test-p3-browser.mjs",
    "test:p4": "node scripts/test-p4.mjs",
    "test:p4:browser": "node scripts/test-p4-browser.mjs",
    "test:satisfaction-questions": "node scripts/test-satisfaction-questions.mjs",
    "test:satisfaction:browser": "SAT_QUESTION_CHECK=1 node scripts/test-p4-browser.mjs",
    "test:p5": "node scripts/test-p5.mjs",
    "test:p5:browser": "node scripts/test-p5-browser.mjs",
    "test:p6": "node scripts/test-p6.mjs",
    "test:p6:browser": "node scripts/test-p6-browser.mjs",
    "test:p7": "node scripts/test-p7.mjs",
    "test:p7:browser": "node scripts/test-p7-browser.mjs",
    "test:p8": "node scripts/test-p8-regression.mjs all",
    "test:p8:core": "node scripts/test-p8-regression.mjs core",
    "test:p8:regression": "node scripts/test-p8-regression.mjs browser",
    "test:p8:browser": "node scripts/test-p8-browser.mjs",
    "test:p8:migration": "node scripts/test-p8-migration.mjs",
    "test:p8:checks": "node scripts/test-p8-regression.mjs checks",
    "test:p9:staging": "node scripts/test-p9-staging.mjs",
    "test:p9:browser": "node scripts/test-p9-browser.mjs",
    "test:layout-image": "node scripts/test-layout-image.mjs",
    "test:current-ui": "node scripts/test-current-ui.mjs",
    "test:ui-restore": "node scripts/test-ui-restore.mjs",
    "test:dashboard-reads": "node scripts/test-dashboard-reads.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "lucide-react": "^0.525.0",
    "next": "^15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.4",
    "xlsx": "^0.18.5",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "tailwindcss": "^4.1.8",
    "@tailwindcss/postcss": "^4.1.8",
    "postcss": "^8.5.6",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.4",
    "@eslint/eslintrc": "^3.3.1",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12"
  }
}
